    <path android:fillColor="#EF4444" android:pathData="M77.4,54m-1.7,0a1.7,1.7 0 1,1 3.4,0a1.7,1.7 0 1,1 -3.4,0" />
    <path android:fillColor="#EF4444" android:pathData="M68.3,72.2m-1.7,0a1.7,1.7 0 1,1 3.4,0a1.7,1.7 0 1,1 -3.4,0" />
    <path android:fillColor="#F59E0B" android:pathData="M39.7,72.2m-1.7,0a1.7,1.7 0 1,1 3.4,0a1.7,1.7 0 1,1 -3.4,0" />
