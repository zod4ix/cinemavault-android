{
  "name": "cinemavault-app",
  "private": true,
  "version": "3.7.5",
  "description": "CinemaVault PRO (Vinegret.Net) — 4K HDR Online Cinema, UAKino & Live Sports",
  "author": {
    "name": "Vinegret.Net (CinemaVault PRO)",
    "url": "https://vinegret.net"
  },
  "homepage": "https://vinegret.net/prostye-poleznye-programmy-dlja-windows/",
  "releaseNotes": "• 🚀 ОФІЦІЙНИЙ РЕЛІЗ 3.7.5: БЕЗШОВНИЙ DEEP LINKING, НАДСИЛАННЯ ФІЛЬМІВ ДРУГУ В ДОДАТКУ ЗА ID, ВИПРАВЛЕННЯ ВВЕДЕННЯ ПОШТИ НА ПРОЄКТОРАХ ТА МАКСИМАЛЬНА БЕЗПЕКА WINDOWS & ANDROID:\n• 🔗 РОЗУМНЕ ПОДІЛИТИСЯ ТА ПРЯМЕ НАДСИЛАННЯ ДРУГУ ЗА ID: нове вікно «Надіслати другу в CinemaVault» за персональним ID з миттєвою доставкою контенту на екран друга, швидкі коди фільмів та оновлена інтеграція Viber, Telegram і WhatsApp.\n• ⌨️ ВИПРАВЛЕНО ВВЕДЕННЯ EMAIL ТА ФОКУС НА ПРОЄКТОРАХ: усунено конфлікт фокусування WebView, через який курсор злітав з поля поштової адреси; автоматичне безшовне відкриття екранної пульт-клавіатури для ТВ та проєкторів.\n• 💻 БЕЗПЕКА WINDOWS ТА ЗАХИСТ ВІД SMARTSCREEN: повні метадані PE-видавця Vinegret.Net, безпечна пісочниця Electron, обробка схеми cinemavault:// без шелл-ін'єкцій та захист користувача від сторонніх редиректів.\n• 📱 ANDROID 16 & SMART TV READY: стабільна робота на всіх типах пультів (D-Pad, Air Mouse, проєкторний режим курсора), апаратне прискорення 60 FPS та відсутність реклами.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/qa_test_suite.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "cd android && gradlew.bat assembleRelease",
    "electron:start": "electron .",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:desktop": "npm run build && electron-builder -mw",
    "report:telegram": "node scripts/send_telegram_report.mjs"
  },
  "build": {
    "appId": "net.cinemavault.pro",
    "productName": "CinemaVault PRO",
    "copyright": "Copyright © 2026 Vinegret.Net — CinemaVault PRO",
    "npmRebuild": false,
    "artifactName": "CinemaVault-PRO-v${version}-${os}.${ext}",
    "protocols": [
      {
        "name": "CinemaVault PRO Deep Link",
        "schemes": [
          "cinemavault"
        ]
      }
    ],
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CinemaVault-PRO-v${version}-Windows.${ext}",
      "icon": "electron/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Vinegret.Net / CinemaVault PRO",
      "signtoolOptions": {
        "publisherName": [
          "Vinegret.Net"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "CinemaVault PRO",
      "uninstallDisplayName": "CinemaVault PRO v${version} (Vinegret.Net)",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "artifactName": "CinemaVault-PRO-v${version}-macOS.${ext}",
      "identity": null,
      "icon": "electron/icon.png",
      "category": "public.app-category.entertainment",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "minimumSystemVersion": "10.15.0"
    },
    "dmg": {
      "title": "CinemaVault PRO ${version}",
      "icon": "electron/icon.png",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@webtor/embed-sdk-js": "^0.2.19",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
