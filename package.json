{
  "name": "cinemavault-app",
  "private": true,
  "version": "3.7.2",
  "description": "CinemaVault PRO — 4K HDR Online Cinema & Live Sports",
  "author": "CinemaVault PRO",
  "releaseNotes": "• 🏆 ОФІЦІЙНИЙ РЕЛІЗ 3.7.2: HDREZKA #1 ТА ПОВНИЙ АДБЛОК: HDRezka виведено на перше місце в ієрархії серверів з пріоритетом українського дубляжу. Впроваджено тотальний дворівневий AdBlock — жодної реклами та переривань при натисканні Play.\n• ⚽ ОНОВЛЕННЯ СПОРТУ: матчі, що завершилися, не зависають у прямому ефірі; кнопка сканування оновлює потоки з живою телеметрією; результати матчів виносяться окремо та зберігаються до 48 годин; анонси майбутніх подій розміщені суворо після поточних трансляцій; точне визначення ліг (без фальшивих 'Ліга чемпіонів') та назви команд великими літерами.\n• ⚡ ЧИСТИЙ ТА ОПТИМІЗОВАНИЙ КОД: усунено фіктивні кнопки, полегшено додаток та підвищено загальну швидкодію.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "cd android && gradlew.bat assembleRelease",
    "electron:start": "electron .",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:desktop": "npm run build && electron-builder -mw"
  },
  "build": {
    "appId": "net.cinemavault.pro",
    "productName": "CinemaVault PRO",
    "npmRebuild": false,
    "artifactName": "CinemaVault-PRO-v${version}-${os}.${ext}",
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CinemaVault-PRO-v${version}-Windows.${ext}",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "CinemaVault PRO"
    },
    "mac": {
      "target": [
        "zip",
        "dir"
      ],
      "artifactName": "CinemaVault-PRO-v${version}-macOS.${ext}",
      "identity": null,
      "icon": "electron/icon.png",
      "category": "public.app-category.entertainment"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@webtor/embed-sdk-js": "^0.2.19",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
