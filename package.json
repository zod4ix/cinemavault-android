{
  "name": "cinemavault-app",
  "private": true,
  "version": "3.7.3",
  "description": "CinemaVault PRO — 4K HDR Online Cinema & Live Sports",
  "author": "CinemaVault PRO",
  "releaseNotes": "• 🚀 ОФІЦІЙНИЙ РЕЛІЗ 3.7.3: ПЛАВНЕ АВТООНОВЛЕННЯ WINDOWS, ДВОМОВНИЙ РОЗУМНИЙ ПОШУК ТА ЄДИНИЙ БРЕНД-ДИЗАЙН:\n• 💻 ПЛАВНЕ ОНОВЛЕННЯ WINDOWS ЯК НА ANDROID: при виході нової версії додаток автоматично сповіщає користувача, завантажує інсталятор з прогрес-баром прямо всередині вікна та безшовно запускає оновлення.\n• 🔍 ІНТЕЛЕКТУАЛЬНИЙ ПОШУК (КИРИЛИЦЯ ⇄ ЛАТИНИЦЯ): миттєвий пошук українською, російською та англійською мовами, розуміння трансліту, автоматичне виправлення розкладки клавіатури (ЙЦУКЕН ⇄ QWERTY) та глибока інтеграція з Wikidata/Wikipedia/IMDb.\n• 🎨 ЄДИНЕ БРЕНДОВЕ ЛОГО ТА ТЕЛЕМЕТРІЯ ПРИСТРОЇВ: фірмовий щит CinemaVault PRO інтегровано у Windows-інсталятор, ярлики робочого столу, панель завдань та Android.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "cd android && gradlew.bat assembleRelease",
    "electron:start": "electron .",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:desktop": "npm run build && electron-builder -mw",
    "report:telegram": "node scripts/send_telegram_report.mjs"
  },
  "build": {
    "appId": "net.cinemavault.pro",
    "productName": "CinemaVault PRO",
    "npmRebuild": false,
    "artifactName": "CinemaVault-PRO-v${version}-${os}.${ext}",
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CinemaVault-PRO-v${version}-Windows.${ext}",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "CinemaVault PRO",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico"
    },
    "mac": {
      "target": [
        "zip",
        "dir"
      ],
      "artifactName": "CinemaVault-PRO-v${version}-macOS.${ext}",
      "identity": null,
      "icon": "electron/icon.png",
      "category": "public.app-category.entertainment"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@webtor/embed-sdk-js": "^0.2.19",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
